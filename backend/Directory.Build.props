<Project>
  <!-- Settings shared by every project under backend/. MSBuild imports this file by itself into
       each .csproj below this folder, so these lines are not repeated in the projects.
       See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- "string" can never be null, "string?" can: the compiler warns about possible nulls. -->
    <Nullable>enable</Nullable>
    <!-- The common namespaces (System, System.Linq...) are imported without a "using" line. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A warning fails the build, so none is left behind. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
